   "source": [
    "SELECT\n",
    "  id_cliente,\n",
    "  COUNT(*) AS total_registos_ativos\n",
    "FROM\n",
    "  novarota.silver.dim_cliente_scd2\n",
    "WHERE\n",
    "  flag_ativo = TRUE\n",
    "GROUP BY\n",
    "  id_cliente\n",
    "HAVING\n",
    "  COUNT(*) > 1"
   ]
  }
